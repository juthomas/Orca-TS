{
  "compilerOptions": {
    "target": "ES2020",
    "module": "None",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist/sources/scripts",
    "rootDir": "sources/scripts",
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": ["sources/scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
